datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  displayName  String
  avatarUrl    String?
  googleId     String?   @unique
  googleToken  String?   // Encrypted AES-256-GCM Google OAuth token payload
  createdAt    DateTime  @default(now())
  meetings     Meeting[]
}

model Meeting {
  id            String         @id @default(uuid())
  title         String
  roomName      String         @unique
  hostId        String
  host          User           @relation(fields: [hostId], references: [id])
  isScheduled   Boolean        @default(false)
  startTime     DateTime?
  endTime       DateTime?
  recurrence    String?        // NONE, DAILY, WEEKLY, MONTHLY, YEARLY
  description   String?
  guestEmails   String[]       @default([])
  moderatorEmails String[]     @default([])
  googleEventId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  configs       MeetingConfig?
  sessionLogs   SessionLog[]
  // Eventyay integration fields
  eventyayEventSlug String?
  eventyayRoomId    String?
  maxParticipants   Int          @default(50)
  guestLinkEnabled  Boolean      @default(false)
  joinPin           String?
}

model MeetingConfig {
  meetingId                 String  @id
  meeting                   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  joinPin                   String?
  lobbyEnabled              Boolean @default(true)
  lobbyForm                 String  @default("name")
  stagePromotionEnabled     Boolean @default(true)
  allowParticipantRecording Boolean @default(false)
  notesTemplate             String?
  sharedNotes               String?
  activePoll                String?
  roomDefaults              String?
  userGrants                String?
  gridBackgroundUrl         String?
}

model OAuthClient {
  id               String   @id @default(uuid())
  clientId         String   @unique
  clientSecretHash String
  name             String
  redirectUris     String[]
  createdAt        DateTime @default(now())
}

model OAuthCode {
  code          String   @id // sha256 of the issued code
  clientId      String
  userId        String
  codeChallenge String
  redirectUri   String
  expiresAt     DateTime
  used          Boolean  @default(false)
}

model OAuthToken {
  id          String    @id @default(uuid())
  userId      String
  clientId    String
  accessHash  String    @unique
  refreshHash String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model EventyayGrantUse {
  jti       String   @id
  usedAt    DateTime @default(now())
  expiresAt DateTime
}

model SessionLog {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  eventType String   // START, END, JOIN, LEAVE, RECORDING_START, RECORDING_STOP
  details   String?  // JSON string
  createdAt DateTime @default(now())
}
